 "cells": [
  {
   "cell_type": "markdown",
   "id": "overview",
   "metadata": {},
   "source": [
    "# Light Intensity and Duration Analysis\n",
    "\n",
    "This notebook analyzes behavioral responses to different light intensities and durations.\n",
    "\n",
    "**Features:**\n",
    "- Compare multiple light duration conditions (0s, 0.3s, 0.5s, 1s, 3s)\n",
    "- Interactive heatmaps showing behavioral patterns\n",
    "- Statistical comparison between conditions\n",
    "- Time-series analysis of behavioral states\n",
    "\n",
    "**Data Organization:**\n",
    "- Data should be organized in subdirectories by duration (e.g., 0s/, 1s/, 3s/)\n",
    "- CSV files should contain processed TruMeLaN data with behavioral states"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "imports",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import plotly.graph_objects as go\n",
    "import plotly.express as px\n",
    "from plotly.subplots import make_subplots\n",
    "import os\n",
    "import glob\n",
    "from pathlib import Path\n",
    "import seaborn as sns\n",
    "from scipy import stats"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "config",
   "metadata": {},
   "outputs": [],
   "source": [
    "# USER CONFIGURATION\n",
    "# ==================\n",
    "\n",
    "# Base path to your light condition data\n",
    "base_path = \"C:\\\\Users\\\\user\\\\Documents\\\\light_data\"  # CHANGE THIS\n",
    "\n",
    "# Light duration conditions to analyze\n",
    "durations = ['0s', '0_3s', '0_5s', '1s', '3s']  # CHANGE THIS as needed\n",
    "\n",
    "# Display names for conditions\n",
    "duration_labels = {\n",
    "    '0s': 'Control (0s)',\n",
    "    '0_3s': '0.3s Light',\n",
    "    '0_5s': '0.5s Light', \n",
    "    '1s': '1s Light',\n",
    "    '3s': '3s Light'\n",
    "}\n",
    "\n",
    "# Output directory\n",
    "output_dir = \"C:\\\\Users\\\\user\\\\Documents\\\\light_figures\"  # CHANGE THIS\n",
    "os.makedirs(output_dir, exist_ok=True)\n",
    "\n",
    "# Analysis parameters\n",
    "fps = 45  # Frame rate\n",
    "analysis_window = 300  # seconds to analyze"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "helper_functions",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Helper Functions\n",
    "# ================\n",
    "\n",
    "def csv_read_light(file, fps=45):\n",
    "    \"\"\"Read and process CSV files for light analysis.\"\"\"\n",
    "    df = pd.read_csv(file)\n",
    "    \n",
    "    # Add time columns\n",
    "    if 'Timestamp (ms)' in df.columns:\n",
    "        df['Time_ms'] = df['Timestamp (ms)'] - df['Timestamp (ms)'].iloc[0]\n",
    "        df['Time_s'] = df['Time_ms'] / 1000\n",
    "        df['Minutes'] = df['Time_s'] / 60\n",
    "        df['Hours'] = df['Minutes'] / 60\n",
    "    \n",
    "    # Add bout tracking if State column exists\n",
    "    if 'State' in df.columns:\n",
    "        df['State_numeric'] = df['State'].map({\n",
    "            'Stationary Static': 1,\n",
    "            'Stationary Active': 2,\n",
    "            'Locomotive': 3,\n",
    "            'Unknown': 0\n",
    "        })\n",
    "        \n",
    "        # Identify state transitions\n",
    "        df['State_change'] = (df['State_numeric'] != df['State_numeric'].shift(1)).astype(int)\n",
    "        df['Bout_number'] = df['State_change'].cumsum()\n",
    "    \n",
    "    return df\n",
    "\n",
    "def load_duration_data(base_path, durations):\n",
    "    \"\"\"Load data for all duration conditions.\"\"\"\n",
    "    data = {}\n",
    "    \n",
    "    for duration in durations:\n",
    "        data[duration] = []\n",
    "        duration_path = os.path.join(base_path, duration)\n",
    "        \n",
    "        if not os.path.exists(duration_path):\n",
    "            print(f\"Warning: Directory not found: {duration_path}\")\n",
    "            continue\n",
    "            \n",
    "        # Find all CSV files in the duration directory\n",
    "        csv_files = glob.glob(os.path.join(duration_path, '**', '*.csv'), recursive=True)\n",
    "        \n",
    "        print(f\"Loading {len(csv_files)} files from {duration}...\")\n",
    "        \n",
    "        for file in csv_files:\n",
    "            try:\n",
    "                df = csv_read_light(file, fps)\n",
    "                df['file_id'] = len(data[duration])  # Add file identifier\n",
    "                data[duration].append(df)\n",
    "            except Exception as e:\n",
    "                print(f\"Error loading {file}: {e}\")\n",
    "    \n",
    "    return data\n",
    "\n",
    "def create_condition_summary(data):\n",
    "    \"\"\"Create summary statistics for each condition.\"\"\"\n",
    "    summary = {}\n",
    "    \n",
    "    for condition, files in data.items():\n",
    "        if not files:\n",
    "            continue\n",
    "            \n",
    "        # Combine all files for this condition\n",
    "        combined_df = pd.concat(files, ignore_index=True)\n",
    "        \n",
    "        summary[condition] = {\n",
    "            'n_files': len(files),\n",
    "            'total_records': len(combined_df),\n",
    "            'avg_activity': combined_df.get('Activity Level', pd.Series()).mean(),\n",
    "            'avg_speed': combined_df.get('Speed_Av_mm_per_sec', pd.Series()).mean(),\n",
    "            'locomotive_pct': (combined_df.get('State') == 'Locomotive').mean() * 100 if 'State' in combined_df.columns else None\n",
    "        }\n",
    "    \n",
    "    return summary\n",
    "\n",
    "def create_heatmap_data(data, metric='Activity Level', time_limit=300):\n",
    "    \"\"\"Create heatmap data for visualization.\"\"\"\n",
    "    heatmap_data = {}\n",
    "    \n",
    "    for condition, files in data.items():\n",
    "        if not files or metric not in files[0].columns:\n",
    "            continue\n",
    "            \n",
    "        condition_data = []\n",
    "        \n",
    "        for i, df in enumerate(files):\n",
    "            # Limit to analysis window\n",
    "            if 'Time_s' in df.columns:\n",
    "                df_subset = df[df['Time_s'] <= time_limit]\n",
    "            else:\n",
    "                df_subset = df.head(time_limit * fps)  # Approximate\n",
    "            \n",
    "            # Resample to 1-second bins\n",
    "            if 'Time_s' in df_subset.columns:\n",
    "                df_subset['Time_bin'] = (df_subset['Time_s'] // 1).astype(int)\n",
    "                binned = df_subset.groupby('Time_bin')[metric].mean()\n",
    "            else:\n",
    "                # Use frame-based binning\n",
    "                df_subset['Frame_bin'] = (df_subset.index // fps).astype(int)\n",
    "                binned = df_subset.groupby('Frame_bin')[metric].mean()\n",
    "            \n",
    "            condition_data.append(binned)\n",
    "        \n",
    "        heatmap_data[condition] = condition_data\n",
    "    \n",
    "    return heatmap_data\n",
    "\n",
    "print(\"Helper functions loaded successfully!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "load_data",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load Data\n",
    "# =========\n",
    "\n",
    "print(\"Loading light condition data...\")\n",
    "print(f\"Base path: {base_path}\")\n",
    "print(f\"Looking for conditions: {durations}\")\n",
    "\n",
    "# Load all data\n",
    "light_data = load_duration_data(base_path, durations)\n",
    "\n",
    "# Create summary\n",
    "summary = create_condition_summary(light_data)\n",
    "\n",
    "# Display summary\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"DATA SUMMARY\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "for condition, stats in summary.items():\n",
    "    label = duration_labels.get(condition, condition)\n",
    "    print(f\"\\n{label}:\")\n",
    "    print(f\"  Files: {stats['n_files']}\")\n",
    "    print(f\"  Total records: {stats['total_records']}\")\n",
    "    if stats['avg_activity'] is not None:\n",
    "        print(f\"  Avg activity: {stats['avg_activity']:.2f}\")\n",
    "    if stats['avg_speed'] is not None:\n",
    "        print(f\"  Avg speed: {stats['avg_speed']:.2f} mm/s\")\n",
    "    if stats['locomotive_pct'] is not None:\n",
    "        print(f\"  Locomotive: {stats['locomotive_pct']:.1f}%\")\n",
    "\n",
    "print(\"\\nData loading complete!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "activity_heatmap",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Activity Level Heatmap\n",
    "# ======================\n",
    "\n",
    "if any('Activity Level' in files[0].columns for files in light_data.values() if files):\n",
    "    print(\"Creating Activity Level heatmap...\")\n",
    "    \n",
    "    # Create heatmap data\n",
    "    heatmap_data = create_heatmap_data(light_data, 'Activity Level', analysis_window)\n",
    "    \n",
    "    # Create subplot figure\n",
    "    n_conditions = len([c for c in durations if c in heatmap_data and heatmap_data[c]])\n",
    "    \n",
    "    if n_conditions > 0:\n",
    "        fig = make_subplots(\n",
    "            rows=n_conditions, cols=1,\n",
    "            subplot_titles=[duration_labels.get(c, c) for c in durations if c in heatmap_data and heatmap_data[c]],\n",
    "            vertical_spacing=0.05\n",
    "        )\n",
    "        \n",
    "        row = 1\n",
    "        for condition in durations:\n",
    "            if condition not in heatmap_data or not heatmap_data[condition]:\n",
    "                continue\n",
    "                \n",
    "            # Combine data from all flies\n",
    "            condition_matrix = []\n",
    "            max_time = 0\n",
    "            \n",
    "            for fly_data in heatmap_data[condition]:\n",
    "                if len(fly_data) > max_time:\n",
    "                    max_time = len(fly_data)\n",
    "            \n",
    "            # Pad and collect data\n",
    "            for fly_data in heatmap_data[condition]:\n",
    "                padded = np.full(max_time, np.nan)\n",
    "                padded[:len(fly_data)] = fly_data.values\n",
    "                condition_matrix.append(padded)\n",
    "            \n",
    "            if condition_matrix:\n",
    "                matrix = np.array(condition_matrix)\n",
    "                \n",
    "                fig.add_trace(\n",
    "                    go.Heatmap(\n",
    "                        z=matrix,\n",
    "                        colorscale='Viridis',\n",
    "                        showscale=(row == 1),\n",
    "                        colorbar=dict(title=\"Activity Level\") if row == 1 else None\n",
    "                    ),\n",
    "                    row=row, col=1\n",
    "                )\n",
    "            \n",
    "            row += 1\n",
    "        \n",
    "        fig.update_layout(\n",
    "            height=300 * n_conditions,\n",
    "            title=\"Activity Level Across Light Conditions\",\n",
    "            showlegend=False\n",
    "        )\n",
    "        \n",
    "        fig.update_xaxes(title=\"Time (seconds)\")\n",
    "        fig.update_yaxes(title=\"Fly\")\n",
    "        \n",
    "        fig.show()\n",
    "        \n",
    "        # Save figure\n",
    "        fig.write_html(os.path.join(output_dir, \"activity_level_heatmap.html\"))\n",
    "        print(f\"Heatmap saved to {output_dir}\")\n",
    "    else:\n",
    "        print(\"No valid data for heatmap\")\n",
    "else:\n",
    "    print(\"Activity Level column not found in data\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "speed_comparison",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Speed Comparison\n",
    "# ================\n",
    "\n",
    "if any('Speed_Av_mm_per_sec' in files[0].columns for files in light_data.values() if files):\n",
    "    print(\"Creating speed comparison...\")\n",
    "    \n",
    "    # Prepare data for plotting\n",
    "    speed_data = []\n",
    "    \n",
    "    for condition, files in light_data.items():\n",
    "        if not files or 'Speed_Av_mm_per_sec' not in files[0].columns:\n",
    "            continue\n",
    "            \n",
    "        for df in files:\n",
    "            # Calculate average speed for this file\n",
    "            if 'Time_s' in df.columns:\n",
    "                df_subset = df[df['Time_s'] <= analysis_window]\n",
    "            else:\n",
    "                df_subset = df.head(analysis_window * fps)\n",
    "                \n",
    "            avg_speed = df_subset['Speed_Av_mm_per_sec'].mean()\n",
    "            speed_data.append({\n",
    "                'Condition': duration_labels.get(condition, condition),\n",
    "                'Speed': avg_speed\n",
    "            })\n",
    "    \n",
    "    if speed_data:\n",
    "        speed_df = pd.DataFrame(speed_data)\n",
    "        \n",
    "        # Create box plot\n",
    "        fig = px.box(\n",
    "            speed_df, \n",
    "            x='Condition', \n",
    "            y='Speed',\n",
    "            title=\"Speed Distribution Across Light Conditions\",\n",
    "            labels={'Speed': 'Average Speed (mm/s)'}\n",
    "        )\n",
    "        \n",
    "        fig.update_layout(\n",
    "            xaxis_tickangle=-45,\n",
    "            height=500\n",
    "        )\n",
    "        \n",
    "        fig.show()\n",
    "        \n",
    "        # Save figure\n",
    "        fig.write_html(os.path.join(output_dir, \"speed_comparison.html\"))\n",
    "        \n",
    "        # Statistical analysis\n",
    "        print(\"\\nSpeed Statistics by Condition:\")\n",
    "        stats_summary = speed_df.groupby('Condition')['Speed'].agg(['count', 'mean', 'std']).round(3)\n",
    "        print(stats_summary)\n",
    "        \n",
    "        # Pairwise t-tests if more than one condition\n",
    "        conditions = speed_df['Condition'].unique()\n",
    "        if len(conditions) > 1:\n",
    "            print(\"\\nPairwise comparisons (p-values):\")\n",
    "            for i, cond1 in enumerate(conditions):\n",
    "                for j, cond2 in enumerate(conditions):\n",
    "                    if i < j:\n",
    "                        group1 = speed_df[speed_df['Condition'] == cond1]['Speed']\n",
    "                        group2 = speed_df[speed_df['Condition'] == cond2]['Speed']\n",
    "                        _, p_val = stats.ttest_ind(group1, group2)\n",
    "                        print(f\"{cond1} vs {cond2}: p = {p_val:.4f}\")\n",
    "    else:\n",
    "        print(\"No speed data available\")\n",
    "else:\n",
    "    print(\"Speed column not found in data\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "state_analysis",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Behavioral State Analysis\n",
    "# =========================\n",
    "\n",
    "if any('State' in files[0].columns for files in light_data.values() if files):\n",
    "    print(\"Creating behavioral state analysis...\")\n",
    "    \n",
    "    # Prepare state proportion data\n",
    "    state_data = []\n",
    "    \n",
    "    for condition, files in light_data.items():\n",
    "        if not files or 'State' not in files[0].columns:\n",
    "            continue\n",
    "            \n",
    "        for df in files:\n",
    "            if 'Time_s' in df.columns:\n",
    "                df_subset = df[df['Time_s'] <= analysis_window]\n",
    "            else:\n",
    "                df_subset = df.head(analysis_window * fps)\n",
    "            \n",
    "            # Calculate state proportions\n",
    "            state_counts = df_subset['State'].value_counts(normalize=True)\n",
    "            \n",
    "            for state, proportion in state_counts.items():\n",
    "                state_data.append({\n",
    "                    'Condition': duration_labels.get(condition, condition),\n",
    "                    'State': state,\n",
    "                    'Proportion': proportion\n",
    "                })\n",
    "    \n",
    "    if state_data:\n",
    "        state_df = pd.DataFrame(state_data)\n",
    "        \n",
    "        # Create stacked bar chart\n",
    "        fig = px.bar(\n",
    "            state_df,\n",
    "            x='Condition',\n",
    "            y='Proportion',\n",
    "            color='State',\n",
    "            title=\"Behavioral State Distribution Across Light Conditions\",\n",
    "            labels={'Proportion': 'Proportion of Time'}\n",
    "        )\n",
    "        \n",
    "        fig.update_layout(\n",
    "            xaxis_tickangle=-45,\n",
    "            height=500,\n",
    "            barmode='stack'\n",
    "        )\n",
    "        \n",
    "        fig.show()\n",
    "        \n",
    "        # Save figure\n",
    "        fig.write_html(os.path.join(output_dir, \"behavioral_states.html\"))\n",
    "        \n",
    "        # Summary statistics\n",
    "        print(\"\\nBehavioral State Proportions:\")\n",
    "        pivot_table = state_df.pivot_table(\n",
    "            index='Condition', \n",
    "            columns='State', \n",
    "            values='Proportion', \n",
    "            aggfunc='mean'\n",
    "        ).round(3)\n",
    "        print(pivot_table)\n",
    "        \n",
    "        # Calculate locomotion rates\n",
    "        locomotion_data = state_df[state_df['State'] == 'Locomotive'].groupby('Condition')['Proportion'].agg(['mean', 'std']).round(3)\n",
    "        print(\"\\nLocomotion Rates:\")\n",
    "        print(locomotion_data)\n",
    "    else:\n",
    "        print(\"No state data available\")\n",
    "else:\n",
    "    print(\"State column not found in data\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "time_series",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Time Series Analysis\n",
    "# ====================\n",
    "\n",
    "print(\"Creating time series analysis...\")\n",
    "\n",
    "# Select metric for time series\n",
    "metric = 'Activity Level'\n",
    "if not any(metric in files[0].columns for files in light_data.values() if files):\n",
    "    metric = 'Speed_Av_mm_per_sec'\n",
    "\n",
    "if any(metric in files[0].columns for files in light_data.values() if files):\n",
    "    fig = go.Figure()\n",
    "    \n",
    "    colors = px.colors.qualitative.Set1[:len(durations)]\n",
    "    \n",
    "    for i, condition in enumerate(durations):\n",
    "        if condition not in light_data or not light_data[condition]:\n",
    "            continue\n",
    "            \n",
    "        if metric not in light_data[condition][0].columns:\n",
    "            continue\n",
    "            \n",
    "        # Calculate average time series for this condition\n",
    "        time_series_data = []\n",
    "        \n",
    "        for df in light_data[condition]:\n",
    "            if 'Time_s' in df.columns:\n",
    "                df_subset = df[df['Time_s'] <= analysis_window]\n",
    "                # Bin by 5-second intervals\n",
    "                df_subset['Time_bin'] = (df_subset['Time_s'] // 5).astype(int) * 5\n",
    "                binned = df_subset.groupby('Time_bin')[metric].mean()\n",
    "            else:\n",
    "                # Use frame-based approach\n",
    "                df_subset = df.head(analysis_window * fps)\n",
    "                bin_size = fps * 5  # 5 second bins\n",
    "                df_subset['Frame_bin'] = (df_subset.index // bin_size).astype(int) * 5\n",
    "                binned = df_subset.groupby('Frame_bin')[metric].mean()\n",
    "            \n",
    "            time_series_data.append(binned)\n",
    "        \n",
    "        if time_series_data:\n",
    "            # Combine and calculate mean\n",
    "            combined = pd.concat(time_series_data, axis=1)\n",
    "            mean_series = combined.mean(axis=1)\n",
    "            std_series = combined.std(axis=1)\n",
    "            \n",
    "            # Add mean line\n",
    "            fig.add_trace(\n",
    "                go.Scatter(\n",
    "                    x=mean_series.index,\n",
    "                    y=mean_series.values,\n",
    "                    mode='lines',\n",
    "                    name=duration_labels.get(condition, condition),\n",
    "                    line=dict(color=colors[i % len(colors)], width=2)\n",
    "                )\n",
    "            )\n",
    "            \n",
    "            # Add confidence interval\n",
    "            if not std_series.isna().all():\n",
    "                fig.add_trace(\n",
    "                    go.Scatter(\n",
    "                        x=list(mean_series.index) + list(mean_series.index)[::-1],\n",
    "                        y=list(mean_series + std_series) + list(mean_series - std_series)[::-1],\n",
    "                        fill='tonexty',\n",
    "                        fillcolor=f\"rgba({colors[i % len(colors)][4:-1]}, 0.2)\",\n",
    "                        line=dict(color=\"rgba(255,255,255,0)\"),\n",
    "                        showlegend=False,\n",
    "                        hoverinfo=\"skip\"\n",
    "                    )\n",
    "                )\n",
    "    \n",
    "    fig.update_layout(\n",
    "        title=f\"{metric} Over Time by Light Condition\",\n",
    "        xaxis_title=\"Time (seconds)\",\n",
    "        yaxis_title=metric,\n",
    "        height=500,\n",
    "        hovermode='x'\n",
    "    )\n",
    "    \n",
    "    fig.show()\n",
    "    \n",
    "    # Save figure\n",
    "    fig.write_html(os.path.join(output_dir, f\"time_series_{metric.replace(' ', '_').lower()}.html\"))\n",
    "    \n",
    "else:\n",
    "    print(f\"No suitable metric found for time series analysis\")\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"ANALYSIS COMPLETE!\")\n",
    "print(f\"All figures saved to: {output_dir}\")\n",
    "print(\"=\"*60)"
   ]
  }
